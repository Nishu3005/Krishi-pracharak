"""
CSS and HTML helpers for the Grower Network Intelligence home page (app.py).
"""
import streamlit as st
from utils.landing_theme import IMG_HERO


def inject_home_css() -> None:
    st.markdown("""
<style>
/* ── Home hero ───────────────────────────────────────────────────────────────── */
.kp-home-hero {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  min-height: 360px;
  display: flex;
  align-items: flex-end;
  margin-bottom: 2rem;
  box-shadow: 0 16px 48px rgba(15,31,21,0.22);
}
.kp-home-hero-img {
  position: absolute;
  inset: 0;
  
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 50%;
  display: block;
}
.kp-home-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(8,18,12,0.90) 0%,
    rgba(8,18,12,0.50) 45%,
    rgba(8,18,12,0.08) 100%
  );
}
.kp-home-hero-content {
  position: relative;
  z-index: 2;
  padding: 2rem 2.4rem;
  width: 100%;
}
.kp-home-hero-kicker {
  display: inline-block;
  background: rgba(47,125,76,0.5);
  border: 1px solid rgba(47,125,76,0.65);
  color: #a8e6be;
  border-radius: 999px;
  padding: 0.2rem 0.75rem;
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  margin-bottom: 0.7rem;
}
.kp-home-hero-title {
  font-family: "Source Serif 4", serif;
  font-size: 2.4rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.03em;
  margin: 0 0 0.45rem;
  line-height: 1.1;
}
.kp-home-hero-sub {
  color: rgba(210,235,218,0.78);
  font-size: 0.95rem;
  line-height: 1.6;
  max-width: 600px;
  margin: 0;
}

/* ── Metric strip ────────────────────────────────────────────────────────────── */
.kp-home-metrics {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.8rem;
  margin-bottom: 1.8rem;
}
.kp-home-metric {
  background: #fffdf7;
  border: 1px solid #e8e4da;
  border-radius: 12px;
  padding: 0.9rem 1rem;
  box-shadow: 0 1px 4px rgba(26,37,32,0.04);
  transition: border-color 0.15s;
}
.kp-home-metric:hover { border-color: #b8d4be; }
.kp-home-metric-val {
  font-family: "Source Serif 4", serif;
  font-size: 1.65rem;
  font-weight: 700;
  color: #1a2520;
  line-height: 1;
  margin-bottom: 0.2rem;
}
.kp-home-metric-val-g { color: #2f7d4c; }
.kp-home-metric-lbl {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #8a9e92;
}

/* ── Section heading ─────────────────────────────────────────────────────────── */
.kp-home-section {
  font-family: "Source Serif 4", serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: #1a2520;
  margin: 1.6rem 0 0.3rem;
  letter-spacing: -0.01em;
}
.kp-home-section-sub {
  font-size: 0.78rem;
  color: #8a9e92;
  margin-bottom: 1rem;
  line-height: 1.5;
}

/* ── Chart card ──────────────────────────────────────────────────────────────── */
.kp-home-chart {
  background: #fffdf7;
  border: 1px solid #e8e4da;
  border-radius: 14px;
  padding: 1rem 1rem 0.5rem;
  box-shadow: 0 1px 4px rgba(26,37,32,0.04);
  margin-bottom: 0.8rem;
}
.kp-home-chart-title {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #8a9e92;
  margin-bottom: 0.6rem;
}
</style>
""", unsafe_allow_html=True)


def home_hero_html(subtitle: str) -> str:
    return (
        f'<div class="kp-home-hero">'
        f'<img class="kp-home-hero-img" src="{IMG_SUNFLOWER}" alt="Agricultural field" />'
        f'<div class="kp-home-hero-overlay"></div>'
        f'<div class="kp-home-hero-content">'
        f'<div class="kp-home-hero-kicker">🌾 Syngenta · Grower Intelligence</div>'
        f'<div class="kp-home-hero-title">Krishi Pracharak</div>'
        f'<div class="kp-home-hero-sub">{subtitle}</div>'
        f'</div>'
        f'</div>'
    )


def home_metrics_html(metrics: list[tuple[str, str, bool]]) -> str:
    """metrics: list of (value, label, is_green)"""
    cards = ""
    for val, lbl, green in metrics:
        cls = "kp-home-metric-val-g" if green else ""
        cards += (
            f'<div class="kp-home-metric">'
            f'<div class="kp-home-metric-val {cls}">{val}</div>'
            f'<div class="kp-home-metric-lbl">{lbl}</div>'
            f'</div>'
        )
    return f'<div class="kp-home-metrics">{cards}</div>'


def home_section(title: str, subtitle: str = "") -> None:
    sub = f'<div class="kp-home-section-sub">{subtitle}</div>' if subtitle else ""
    st.markdown(
        f'<div class="kp-home-section">{title}</div>{sub}',
        unsafe_allow_html=True,
    )
