"""
CSS and HTML helpers for the Campaign Builder landing/welcome page.
Kept separate from ui_theme.py so the landing design can evolve independently.
"""
import streamlit as st

# ── Syngenta CDN images (all confirmed HTTP 200) ───────────────────────────────
IMG_HERO        = "https://www.syngenta.com/sites/default/files/styles/f_p_s_c_1920x728/public/2024-11/Print_Agriculture%20field%20at%20sunset%2C%20green%20wheat%20and%20soil.jpg.webp?itok=22PmQQc0"
IMG_WHEAT_SQ    = "https://www.syngenta.com/sites/default/files/styles/s_c_708x712/public/2024-11/Print_Agriculture%20field%20at%20sunset%2C%20green%20wheat%20and%20soil.jpg.webp?itok=Q8inAcGj"
IMG_SUNFLOWER   = "https://www.syngenta.com/sites/default/files/styles/small_full_width/public/2025-04/Medium%20res%20image-Sunflower%20field%20using%20regenerative%20agriculture%20practices.png.webp?itok=0qQ_r1ip"
IMG_CORN        = "https://www.syngenta.com/sites/default/files/styles/image_focal_point/public/2025-02/Medium%20res%20image-Close-up%20of%20fresh%20corn.png?h=3dbd9eac&itok=k2vTur9Q"
IMG_PEOPLE      = "https://www.syngenta.com/sites/default/files/styles/small_full_width/public/2024-07/BG%20image%20people16.png.webp?itok=Z41CcO2k"
IMG_HYBRID      = "https://www.syngenta.com/sites/default/files/styles/s_c_556x320/public/2026-02/screen-ppt-png-hybrid-wheat_chartres_france_2018-3-2000x1333.jpg.webp?itok=ctew35Ro"
IMG_FIELD_FOCAL = "https://www.syngenta.com/sites/default/files/styles/image_focal_point/public/2024-11/54dc85f793898994c252d8e06b45bbc8.jpeg?h=aad00b41&itok=z_BPucfs"
IMG_FARMER_MAIZE = "https://www.syngenta.com/sites/default/files/styles/large/public/2024-10/Screen%20PPT_Farmer%20in%20maize%20field%20inspecting%20crop.jpg.webp"
IMG_FARMER_RICE  = "https://www.syngenta.com/sites/default/files/styles/large/public/2024-10/Chinese_female_grower_in_rice_field.jpg.webp"


def inject_landing_css() -> None:
    st.markdown("""
<style>
/* ── Landing page root ───────────────────────────────────────────────────────── */
.kp-landing-wrap {
  max-width: 1160px;
  margin: 0 auto;
  font-family: "Space Grotesk", sans-serif;
}

/* ── Hero ────────────────────────────────────────────────────────────────────── */
.kp-hero {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  min-height: 380px;
  display: flex;
  align-items: flex-end;
  margin-bottom: 2rem;
  box-shadow: 0 20px 60px rgba(15,31,21,0.28);
}
.kp-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 35%;
  display: block;
}
.kp-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10,22,14,0.95) 0%,
    rgba(10,22,14,0.72) 45%,
    rgba(10,22,14,0.45) 100%
  );
}
.kp-hero-content {
  position: relative;
  z-index: 2;
  padding: 2.4rem 2.8rem;
  width: 100%;
}
.kp-hero-kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(47,125,76,0.55);
  border: 1px solid rgba(47,125,76,0.7);
  color: #a8e6be;
  border-radius: 999px;
  padding: 0.22rem 0.85rem;
  font-size: 0.69rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  margin-bottom: 1rem;
  backdrop-filter: blur(6px);
}
.kp-hero-title {
  font-family: "Source Serif 4", serif;
  font-size: 3rem;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.03em;
  line-height: 1.08;
  margin: 0 0 0.65rem;
  text-shadow: 0 2px 24px rgba(0,0,0,0.9), 0 1px 4px rgba(0,0,0,0.8);
}
.kp-hero-sub {
  color: rgba(220,240,228,0.82);
  font-size: 1rem;
  line-height: 1.65;
  max-width: 540px;
  margin: 0 0 1.8rem;
}
.kp-hero-stats {
  display: flex;
  gap: 0;
  flex-wrap: wrap;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 14px;
  backdrop-filter: blur(12px);
  overflow: hidden;
  width: fit-content;
}
.kp-hero-stat {
  padding: 0.85rem 1.4rem;
  border-right: 1px solid rgba(255,255,255,0.1);
  min-width: 90px;
}
.kp-hero-stat:last-child { border-right: none; }
.kp-hero-stat-val {
  font-family: "Source Serif 4", serif;
  font-size: 1.55rem;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  margin-bottom: 0.18rem;
}
.kp-hero-stat-val.accent { color: #6dd98c; }
.kp-hero-stat-lbl {
  font-size: 0.62rem;
  color: rgba(200,230,210,0.6);
  text-transform: uppercase;
  letter-spacing: 0.07em;
  font-weight: 500;
}

/* ── How it works strip ──────────────────────────────────────────────────────── */
.kp-how-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1px;
  background: #e2ddd4;
  border: 1px solid #e2ddd4;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 2rem;
}
.kp-how-step {
  background: #fffdf7;
  padding: 1.2rem 1.3rem 1.1rem;
  position: relative;
}
.kp-how-step:hover { background: #f9f6ee; }
.kp-how-num {
  font-family: "Source Serif 4", serif;
  font-size: 0.75rem;
  font-weight: 700;
  color: #2f7d4c;
  letter-spacing: 0.04em;
  margin-bottom: 0.5rem;
  opacity: 0.8;
}
.kp-how-icon {
  font-size: 1.45rem;
  margin-bottom: 0.45rem;
  line-height: 1;
}
.kp-how-label {
  font-size: 0.88rem;
  font-weight: 700;
  color: #1a2520;
  margin-bottom: 0.2rem;
  line-height: 1.25;
}
.kp-how-desc {
  font-size: 0.75rem;
  color: #6b7c72;
  line-height: 1.5;
}
.kp-how-arrow {
  position: absolute;
  right: -10px;
  top: 50%;
  transform: translateY(-50%);
  width: 20px;
  height: 20px;
  background: #fffdf7;
  border: 1px solid #e2ddd4;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.6rem;
  color: #2f7d4c;
  z-index: 2;
}
.kp-how-step:last-child .kp-how-arrow { display: none; }

/* ── Section header ──────────────────────────────────────────────────────────── */
.kp-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1rem;
  padding-bottom: 0.6rem;
  border-bottom: 1px solid #e8e4da;
}
.kp-section-title {
  font-family: "Source Serif 4", serif;
  font-size: 1.15rem;
  font-weight: 700;
  color: #1a2520;
  letter-spacing: -0.015em;
}
.kp-section-count {
  font-size: 0.78rem;
  color: #8a9e92;
  font-weight: 500;
}

/* ── Campaign cards ──────────────────────────────────────────────────────────── */
.kp-ccard {
  background: #fffdf7;
  border: 1px solid #e8e4da;
  border-radius: 14px;
  overflow: hidden;
  transition: border-color 0.15s, box-shadow 0.15s;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.kp-ccard:hover {
  border-color: #b8d4be;
  box-shadow: 0 4px 20px rgba(26,37,32,0.09);
}
.kp-ccard-img {
  width: 100%;
  height: 120px;
  object-fit: cover;
  display: block;
  flex-shrink: 0;
}
.kp-ccard-body {
  padding: 0.9rem 1rem 0.8rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.kp-ccard-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0.4rem;
}
.kp-ccard-type {
  font-size: 0.63rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #7a8c82;
}
.kp-ccard-badge {
  border-radius: 999px;
  padding: 0.1rem 0.5rem;
  font-size: 0.62rem;
  font-weight: 700;
  flex-shrink: 0;
}
.kp-ccard-badge-green { background: #eef7f1; color: #2f7d4c; }
.kp-ccard-badge-amber { background: #fdf0e0; color: #b8701f; }
.kp-ccard-badge-gray  { background: #f2f2f0; color: #888; }
.kp-ccard-name {
  font-size: 0.93rem;
  font-weight: 700;
  color: #1a2520;
  line-height: 1.3;
  margin-bottom: 0.18rem;
}
.kp-ccard-meta {
  font-size: 0.72rem;
  color: #8a9e92;
  margin-bottom: 0.85rem;
}
.kp-ccard-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.4rem;
  margin-bottom: 0.65rem;
}
.kp-ccard-stat {
  text-align: center;
  padding: 0.38rem 0.25rem;
  border-radius: 8px;
}
.kp-ccard-stat-n  { background: #f5f2eb; }
.kp-ccard-stat-g  { background: #eef7f1; }
.kp-stat-val {
  font-family: "Source Serif 4", serif;
  font-size: 0.95rem;
  font-weight: 700;
  color: #1a2520;
  line-height: 1.1;
}
.kp-stat-val-g { color: #2f7d4c; }
.kp-stat-lbl {
  font-size: 0.58rem;
  color: #8a9e92;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-top: 0.08rem;
}
.kp-ccard-rates {
  font-size: 0.67rem;
  color: #6b7c72;
  margin-top: auto;
}
.kp-ccard-growers {
  font-size: 0.84rem;
  font-weight: 600;
  color: #2f7d4c;
  margin-top: auto;
}
</style>
""", unsafe_allow_html=True)


# ── Crop → image mapping for card thumbnails ───────────────────────────────────
_CROP_IMAGES: dict[str, str] = {
    "wheat":     IMG_WHEAT_SQ,
    "mustard":   IMG_SUNFLOWER,
    "chickpea":  IMG_FIELD_FOCAL,
    "potato":    IMG_CORN,
    "soybean":   IMG_SUNFLOWER,
    "cotton":    IMG_PEOPLE,
    "paddy":     IMG_HYBRID,
    "rice":      IMG_HYBRID,
    "maize":     IMG_CORN,
    "tomato":    IMG_FIELD_FOCAL,
    "onion":     IMG_FIELD_FOCAL,
    "groundnut": IMG_SUNFLOWER,
    "barley":    IMG_WHEAT_SQ,
}
_IMG_DEFAULT = IMG_FIELD_FOCAL


def crop_img(crop: str) -> str:
    return _CROP_IMAGES.get(crop.lower().strip(), _IMG_DEFAULT)
