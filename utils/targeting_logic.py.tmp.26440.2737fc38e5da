from __future__ import annotations

from datetime import date

import pandas as pd

from utils.product_catalog import (
    PRODUCT_CATALOG,
    get_stage_preferred_products,
)


def _norm_crop(crop: str | None) -> str:
    return str(crop or "").strip().lower()


def get_pos_ranked_skus(pos_df: pd.DataFrame) -> list[str]:
    if pos_df is None or pos_df.empty:
        return []
    ranked = (
        pos_df.groupby("sku_name")["sku_qty"]
        .sum()
        .sort_values(ascending=False)
    )
    return [str(s) for s in ranked.index.tolist()]


def select_campaign_product(
    crop: str | None,
    pos_ranked_skus: list[str],
    timing_label: str | None = None,
    scanned_product: str | None = None,
    disease_risk_type: str | None = None,
    inventory_lookup: dict | None = None,
    territory_id: str | None = None,
) -> tuple[str | None, str]:
    """
    Select the most agronomically appropriate campaign product for a grower.

    Decision order (highest priority first):
      1. Product the grower already scanned  — strongest buying intent signal
      2. Disease/weather outbreak override   — fungicide if fungal risk, insecticide if pest
      3. Stage-aware catalog lookup          — right product for the current crop stage
      4. POS-ranked crop-fit fallback        — best-selling product that fits the crop
      5. Global POS fallback                 — last resort

    At each step, in-stock products are preferred; if all candidates are OOS the
    first candidate is still returned (better to push an OOS message than nothing,
    the OOS gate in targeting_agent will block the grower before sending).
    """
    crop_key = _norm_crop(crop)
    if not crop_key:
        return (pos_ranked_skus[0], "pos_global_fallback") if pos_ranked_skus else (None, "missing_crop")

    inv = inventory_lookup or {}

    def _in_stock(sku: str) -> bool:
        """Return True when inventory data says the product is available (or we can't check)."""
        if not territory_id or not sku:
            return True
        return not inv.get((str(territory_id), str(sku)), False)

    def _first_available(candidates: list[str]) -> str | None:
        """First in-stock candidate, or first candidate overall if all are OOS."""
        in_stock = [s for s in candidates if _in_stock(s)]
        return in_stock[0] if in_stock else (candidates[0] if candidates else None)

    # ── Step 1: Grower scan intent ────────────────────────────────────────────
    # The grower physically scanned this product — they are already aware of it
    # and likely interested. Honour that intent before overriding with stage logic,
    # UNLESS the product has no fit at all with this crop (e.g. scan was accidental
    # or cross-crop).
    if scanned_product and scanned_product in PRODUCT_CATALOG:
        fit_crops = [c.strip().lower() for c in PRODUCT_CATALOG[scanned_product].get("crop_fit", [])]
        if crop_key in fit_crops or not fit_crops:
            if _in_stock(scanned_product):
                return scanned_product, "grower_scan_intent"
            # OOS — note intent but fall through to find the next-best product

    # ── Step 2: Active disease / weather outbreak ─────────────────────────────
    # Real-time weather indicates fungal or pest pressure. Override stage logic
    # with the right product type. Only applies when weather data is available.
    if disease_risk_type in ("fungal", "pest"):
        product_type_wanted = "fungicide" if disease_risk_type == "fungal" else "insecticide"
        disease_candidates = [
            sku for sku, ctx in PRODUCT_CATALOG.items()
            if ctx.get("type", "").startswith(product_type_wanted)
            and crop_key in [c.strip().lower() for c in ctx.get("crop_fit", [])]
        ]
        if disease_candidates:
            chosen = _first_available(disease_candidates)
            if chosen:
                return chosen, f"disease_override_{disease_risk_type}"

    # ── Step 3: Stage-aware product selection ─────────────────────────────────
    # The most important structural fix: choose the product category that is
    # agronomically correct for the current crop growth stage.
    stage_candidates = get_stage_preferred_products(crop_key, timing_label)
    if stage_candidates:
        chosen = _first_available(stage_candidates)
        if chosen:
            stage_tag = (timing_label or "unknown").replace(" ", "_")
            return chosen, f"stage_aware_{stage_tag}"

    # ── Step 4: POS-ranked crop-fit fallback ──────────────────────────────────
    crop_fit_skus = [
        sku for sku, ctx in PRODUCT_CATALOG.items()
        if crop_key in [c.strip().lower() for c in ctx.get("crop_fit", [])]
    ]
    if crop_fit_skus:
        # Prefer the one that sells best in the territory (POS signal)
        for sku in pos_ranked_skus:
            if sku in crop_fit_skus and _in_stock(sku):
                return sku, "pos_crop_fit"
        chosen = _first_available(crop_fit_skus)
        return chosen or crop_fit_skus[0], "catalog_crop_fit"

    # ── Step 5: Global POS fallback ───────────────────────────────────────────
    return (pos_ranked_skus[0], "pos_global_fallback") if pos_ranked_skus else (None, "no_product_found")


def build_inventory_block_lookup(
    inventory_df: pd.DataFrame,
    retailers_df: pd.DataFrame,
    reference_date: date,
    weeks_window: int = 4,
) -> dict[tuple[str, str], bool]:
    if inventory_df.empty or retailers_df.empty:
        return {}

    ref_ts = pd.Timestamp(reference_date)
    window_start = ref_ts - pd.Timedelta(weeks=weeks_window)
    recent_inv = inventory_df[
        (inventory_df["week_end_date"] >= window_start)
        & (inventory_df["week_end_date"] <= ref_ts)
    ].copy()
    if recent_inv.empty:
        return {}

    retailer_territory = retailers_df[["retailer_id", "territory_id"]].drop_duplicates()
    recent_inv = recent_inv.merge(retailer_territory, on="retailer_id", how="left")
    recent_inv = recent_inv.dropna(subset=["territory_id", "sku_name"])

    grouped = (
        recent_inv.groupby(["territory_id", "sku_name"])
        .agg(
            avg_qty=("sku_qty", "mean"),
            oos_weeks=("sku_qty", lambda x: int((x == 0).sum())),
        )
        .reset_index()
    )
    grouped["inventory_blocked"] = (
        (grouped["avg_qty"] < 10)
        | (grouped["oos_weeks"] >= 2)
    )

    return {
        (str(r["territory_id"]), str(r["sku_name"])): bool(r["inventory_blocked"])
        for _, r in grouped.iterrows()
    }
