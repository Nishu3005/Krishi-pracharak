"""
Fetch current weather and 3-day forecast for Indian agricultural state capitals.

Fallback chain (each step is only tried if the previous fails):
  1. Open-Meteo  — primary, no API key, production-safe
  2. wttr.in     — secondary, no API key, city-name based
  3. Seasonal    — offline fallback derived from India's agricultural calendar

All public functions never return None; worst case is a seasonal estimate
marked with "_is_fallback": True so callers can show a disclaimer.
"""
from __future__ import annotations

import json
import urllib.error
import urllib.request
from datetime import datetime
from typing import Optional

# Agricultural hub city per state: (lat, lon, city_name)
STATE_HUBS: dict[str, tuple[float, float, str]] = {
    "Uttar Pradesh":  (26.85, 80.95, "Lucknow"),
    "Rajasthan":      (26.91, 75.79, "Jaipur"),
    "Madhya Pradesh": (23.26, 77.41, "Bhopal"),
    "Bihar":          (25.59, 85.14, "Patna"),
    "Haryana":        (30.74, 76.79, "Chandigarh"),
    "Punjab":         (30.74, 76.79, "Chandigarh"),
    "Maharashtra":    (18.53, 73.85, "Pune"),
    "Gujarat":        (23.03, 72.58, "Ahmedabad"),
    "Karnataka":      (12.97, 77.59, "Bengaluru"),
    "West Bengal":    (22.57, 88.36, "Kolkata"),
}

# WMO weather interpretation codes → human label
WMO_CODES: dict[int, str] = {
    0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
    45: "Fog", 48: "Icy fog",
    51: "Light drizzle", 53: "Moderate drizzle", 55: "Dense drizzle",
    61: "Slight rain", 63: "Moderate rain", 65: "Heavy rain",
    71: "Slight snow", 73: "Moderate snow", 75: "Heavy snow",
    80: "Slight showers", 81: "Moderate showers", 82: "Violent showers",
    95: "Thunderstorm", 96: "Thunderstorm + hail", 99: "Thunderstorm + heavy hail",
}

_TIMEOUT_S   = 5
_OPEN_METEO  = "https://api.open-meteo.com/v1/forecast"
_WTTR_BASE   = "https://wttr.in"


# ── Fallback 3: Seasonal estimate ─────────────────────────────────────────────
def _seasonal_fallback(state: str) -> dict:
    """
    Return representative weather when all live APIs are unreachable.
    Based on India's agricultural seasons and regional climate norms.
    Values are conservative medians — sufficient to trigger disease risk thresholds.
    """
    month = datetime.utcnow().month
    lat, lon, city = STATE_HUBS.get(state, (22.0, 78.0, state))

    # Monsoon Jun-Sep
    if 6 <= month <= 9:
        temp, humidity, wind, rain_3day, condition = 30, 84, 12, 22.0, "Moderate rain"
    # Post-monsoon Oct-Nov
    elif month in (10, 11):
        temp, humidity, wind, rain_3day, condition = 27, 62,  9,  3.0, "Partly cloudy"
    # Rabi winter Dec-Mar
    elif month in (12, 1, 2, 3):
        temp, humidity, wind, rain_3day, condition = 15, 50,  8,  1.0, "Mainly clear"
    # Pre-monsoon hot dry Apr-May
    else:
        temp, humidity, wind, rain_3day, condition = 38, 32, 14,  0.2, "Clear sky"

    # North-Indian fog belt in peak winter
    if state in ("Punjab", "Haryana", "Uttar Pradesh") and month in (12, 1):
        humidity, condition = 74, "Fog"
    # Gujarat / Maharashtra heavier monsoon
    if state in ("Gujarat", "Maharashtra") and 6 <= month <= 9:
        humidity, rain_3day = 88, 30.0

    return {
        "state":        state,
        "city":         city,
        "temp_c":       float(temp),
        "humidity_pct": float(humidity),
        "wind_kmh":     float(wind),
        "condition":    condition,
        "_source":      "seasonal_estimate",
        "_is_fallback": True,
        "forecast_3day": [
            {"date": "", "max_c": temp + 3, "min_c": temp - 5,
             "rain_mm": round(rain_3day / 3, 1)}
            for _ in range(3)
        ],
        "fetched_at": datetime.utcnow().isoformat(),
    }


# ── Source 1: Open-Meteo ───────────────────────────────────────────────────────
def _fetch_open_meteo(lat: float, lon: float, city: str, state: str) -> Optional[dict]:
    params = (
        f"?latitude={lat}&longitude={lon}"
        f"&current=temperature_2m,weather_code,wind_speed_10m,relative_humidity_2m"
        f"&daily=temperature_2m_max,temperature_2m_min,precipitation_sum"
        f"&forecast_days=3&timezone=Asia%2FKolkata"
    )
    try:
        req = urllib.request.Request(
            _OPEN_METEO + params,
            headers={"User-Agent": "KrishiPracharak/1.0"},
        )
        with urllib.request.urlopen(req, timeout=_TIMEOUT_S) as resp:
            data = json.loads(resp.read())

        cur   = data.get("current", {})
        daily = data.get("daily", {})
        code  = cur.get("weather_code")
        condition = WMO_CODES.get(int(code), "Unknown") if code is not None else "Unknown"

        return {
            "state":        state,
            "city":         city,
            "temp_c":       cur.get("temperature_2m"),
            "humidity_pct": cur.get("relative_humidity_2m"),
            "wind_kmh":     cur.get("wind_speed_10m"),
            "condition":    condition,
            "_source":      "open_meteo",
            "forecast_3day": [
                {"date": d, "max_c": mx, "min_c": mn, "rain_mm": rn}
                for d, mx, mn, rn in zip(
                    daily.get("time", []),
                    daily.get("temperature_2m_max", []),
                    daily.get("temperature_2m_min", []),
                    daily.get("precipitation_sum", []),
                )
            ],
            "fetched_at": datetime.utcnow().isoformat(),
        }
    except Exception:
        return None


# ── Source 2: wttr.in ─────────────────────────────────────────────────────────
def _fetch_wttr(city: str, state: str) -> Optional[dict]:
    """
    wttr.in is a public weather service that accepts city names and returns
    JSON with current conditions and 3-day forecast. No API key required.
    Format: https://wttr.in/{city}?format=j1
    """
    city_encoded = city.replace(" ", "+")
    url = f"{_WTTR_BASE}/{city_encoded}?format=j1"
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "KrishiPracharak/1.0"},
        )
        with urllib.request.urlopen(req, timeout=_TIMEOUT_S) as resp:
            data = json.loads(resp.read())

        cur = data["current_condition"][0]
        temp_c     = float(cur.get("temp_C", 25))
        humidity   = float(cur.get("humidity", 50))
        wind_kmph  = float(cur.get("windspeedKmph", 10))
        desc_list  = cur.get("weatherDesc", [{}])
        condition  = desc_list[0].get("value", "Unknown") if desc_list else "Unknown"

        forecast_3day = []
        for day in data.get("weather", [])[:3]:
            max_c  = float(day.get("maxtempC", temp_c + 3))
            min_c  = float(day.get("mintempC", temp_c - 5))
            # Sum precipitation across hourly slots for the day
            hourly = day.get("hourly", [])
            rain_mm = sum(float(h.get("precipMM", 0)) for h in hourly)
            forecast_3day.append({"date": day.get("date", ""), "max_c": max_c,
                                   "min_c": min_c, "rain_mm": round(rain_mm, 1)})

        return {
            "state":        state,
            "city":         city,
            "temp_c":       temp_c,
            "humidity_pct": humidity,
            "wind_kmh":     wind_kmph,
            "condition":    condition,
            "_source":      "wttr_in",
            "forecast_3day": forecast_3day,
            "fetched_at":   datetime.utcnow().isoformat(),
        }
    except Exception:
        return None


# ── Public API ─────────────────────────────────────────────────────────────────
def fetch_weather(state: str) -> dict:
    """
    Return current weather for a state's agricultural hub city.
    Tries three sources in order; always returns a dict (never None).

      1. Open-Meteo (lat/lon, WMO codes, high accuracy)
      2. wttr.in    (city-name lookup, independent data source)
      3. Seasonal   (offline fallback, marked _is_fallback=True)
    """
    coords = STATE_HUBS.get(state)
    if not coords:
        # Unknown state — try wttr.in by state name then fall back to seasonal
        result = _fetch_wttr(state, state)
        return result if result else _seasonal_fallback(state)

    lat, lon, city = coords

    # Source 1: Open-Meteo
    result = _fetch_open_meteo(lat, lon, city, state)
    if result:
        return result

    # Source 2: wttr.in
    result = _fetch_wttr(city, state)
    if result:
        return result

    # Source 3: Seasonal estimate
    return _seasonal_fallback(state)


def fetch_weather_multi(states: list[str]) -> dict[str, dict]:
    """Fetch weather for multiple states. Every state gets a result (never None)."""
    return {s: fetch_weather(s) for s in states}
