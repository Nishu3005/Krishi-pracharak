# Legacy static map — kept for reference only; superseded by STAGE_PRODUCT_MATRIX
CAMPAIGN_PRODUCT_MAP = {
    "wheat":    "Topik 15 WP",
    "mustard":  "Score 250 EC",
    "chickpea": "Actara 25 WG",
    "potato":   "Kavach 75 WP",
}

# ── Stage normalization ────────────────────────────────────────────────────────
# Maps any timing_label value (from crop_calendar.py) to a canonical stage key
_STAGE_NORM: dict[str, str] = {
    # season_phase labels (from _season_phase in crop_calendar.py)
    "pre_sowing":    "pre_sowing",
    "early_season":  "early_season",
    "mid_season":    "mid_season",
    "late_season":   "late_season",
    # stage_based labels (actual crop stage names from grower calendar)
    "tillering":     "tillering",
    "flowering":     "flowering",
    "pod_formation": "pod_formation",
    "grain_fill":    "grain_fill",
    "heading":       "flowering",       # wheat heading ≈ anthesis
    "anthesis":      "flowering",
    "boot_stage":    "tillering",
    "jointing":      "tillering",
    "seedling":      "early_season",
    "germination":   "early_season",
    "vegetative":    "mid_season",
    "maturity":      "late_season",
    "harvest":       "late_season",
    "unknown":       "mid_season",
}

# ── Stage × Crop product preference matrix ────────────────────────────────────
# (crop, stage_category) → ordered list of preferred SKUs
# First entry = most agronomically correct; system walks down the list if OOS.
# Agronomy rationale per entry is in the inline comments.
STAGE_PRODUCT_MATRIX: dict[tuple[str, str], list[str]] = {
    # ── WHEAT ──────────────────────────────────────────────────────────────────
    # pre_sowing: seed treatment window — only chance to protect from soil insects & seed-borne disease
    ("wheat", "pre_sowing"):    ["Cruiser 350 FS", "Vibrance Integral"],
    # early_season / tillering: weed control window (2-4 leaf stage of weeds); also early rust prevention
    ("wheat", "early_season"):  ["Axial 50 EC", "Topik 15 WP", "Tilt 250 EC"],
    ("wheat", "tillering"):     ["Axial 50 EC", "Topik 15 WP", "Tilt 250 EC"],
    # flowering / heading: critical fungicide window — rust & scab spread fast at anthesis
    ("wheat", "flowering"):     ["Tilt 250 EC", "Amistar 250 SC", "Alto 5 SC"],
    # grain fill & late: protect flag leaf; herbicide window is closed
    ("wheat", "grain_fill"):    ["Tilt 250 EC", "Amistar 250 SC"],
    ("wheat", "mid_season"):    ["Tilt 250 EC", "Axial 50 EC"],
    ("wheat", "late_season"):   ["Tilt 250 EC", "Amistar 250 SC"],
    ("wheat", "pod_formation"): ["Tilt 250 EC", "Amistar 250 SC"],

    # ── MUSTARD ────────────────────────────────────────────────────────────────
    # early: painted bug (Bagrada hilaris) surge risk
    ("mustard", "pre_sowing"):    ["Cruiser 350 FS"],
    ("mustard", "early_season"):  ["Actara 25 WG"],
    ("mustard", "tillering"):     ["Actara 25 WG"],
    # mid/flowering: white rust + alternaria blight window
    ("mustard", "mid_season"):    ["Score 250 EC", "Actara 25 WG"],
    ("mustard", "flowering"):     ["Score 250 EC", "Tilt 250 EC"],
    # pod formation: aphid peak + continued white rust risk
    ("mustard", "pod_formation"): ["Score 250 EC", "Actara 25 WG"],
    ("mustard", "late_season"):   ["Score 250 EC"],
    ("mustard", "grain_fill"):    ["Score 250 EC"],

    # ── CHICKPEA ───────────────────────────────────────────────────────────────
    # early: preventive fungicide (botrytis blight risk in humid Rabi)
    ("chickpea", "pre_sowing"):    ["Cruiser 350 FS"],
    ("chickpea", "early_season"):  ["Alto 5 SC"],
    ("chickpea", "mid_season"):    ["Alto 5 SC", "Actara 25 WG"],
    # flowering + pod: pod borer (Helicoverpa) critical — insecticide first
    ("chickpea", "flowering"):     ["Actara 25 WG", "Alto 5 SC"],
    ("chickpea", "pod_formation"): ["Actara 25 WG", "Alto 5 SC"],
    ("chickpea", "grain_fill"):    ["Actara 25 WG"],
    ("chickpea", "late_season"):   ["Actara 25 WG"],

    # ── POTATO ─────────────────────────────────────────────────────────────────
    # All stages: late blight (Phytophthora) is the key risk; also early blight
    ("potato", "pre_sowing"):   ["Cruiser 350 FS"],
    ("potato", "early_season"): ["Kavach 75 WP", "Actara 25 WG"],
    ("potato", "mid_season"):   ["Kavach 75 WP", "Score 250 EC"],
    ("potato", "tillering"):    ["Kavach 75 WP"],
    ("potato", "flowering"):    ["Kavach 75 WP", "Score 250 EC"],
    ("potato", "late_season"):  ["Kavach 75 WP", "Score 250 EC"],
    ("potato", "grain_fill"):   ["Score 250 EC"],

    # ── BARLEY ─────────────────────────────────────────────────────────────────
    ("barley", "pre_sowing"):   ["Cruiser 350 FS", "Vibrance Integral"],
    ("barley", "early_season"): ["Axial 50 EC"],
    ("barley", "tillering"):    ["Axial 50 EC", "Tilt 250 EC"],
    ("barley", "mid_season"):   ["Tilt 250 EC", "Axial 50 EC"],
    ("barley", "flowering"):    ["Tilt 250 EC", "Alto 5 SC"],
    ("barley", "grain_fill"):   ["Tilt 250 EC"],
    ("barley", "late_season"):  ["Tilt 250 EC"],

    # ── MAIZE ──────────────────────────────────────────────────────────────────
    # Movondo is protective — apply before downy mildew onset (early); Amistar for active blast/blight
    ("maize", "pre_sowing"):   ["Cruiser 350 FS"],
    ("maize", "early_season"): ["Movondo", "Amistar 250 SC"],
    ("maize", "tillering"):    ["Movondo", "Amistar 250 SC"],
    ("maize", "mid_season"):   ["Amistar 250 SC", "Movondo"],
    ("maize", "flowering"):    ["Amistar 250 SC"],
    ("maize", "late_season"):  ["Amistar 250 SC"],
    ("maize", "grain_fill"):   ["Amistar 250 SC"],

    # ── LENTIL ─────────────────────────────────────────────────────────────────
    # Seed treatment only valid pre-sowing; after that rust + aphid
    ("lentil", "pre_sowing"):    ["Vibrance Integral", "Cruiser 350 FS"],
    ("lentil", "early_season"):  ["Tilt 250 EC"],
    ("lentil", "mid_season"):    ["Tilt 250 EC", "Actara 25 WG"],
    ("lentil", "tillering"):     ["Tilt 250 EC"],
    ("lentil", "flowering"):     ["Actara 25 WG", "Tilt 250 EC"],
    ("lentil", "pod_formation"): ["Actara 25 WG", "Tilt 250 EC"],
    ("lentil", "late_season"):   ["Tilt 250 EC"],
    ("lentil", "grain_fill"):    ["Actara 25 WG"],

    # ── CUMIN ──────────────────────────────────────────────────────────────────
    # Movondo covers cumin downy mildew + blight; Actara for thrips & aphids
    ("cumin", "pre_sowing"):   ["Cruiser 350 FS"],
    ("cumin", "early_season"): ["Movondo", "Actara 25 WG"],
    ("cumin", "tillering"):    ["Movondo", "Actara 25 WG"],
    ("cumin", "mid_season"):   ["Movondo", "Actara 25 WG"],
    ("cumin", "flowering"):    ["Actara 25 WG", "Movondo"],
    ("cumin", "late_season"):  ["Actara 25 WG"],
    ("cumin", "grain_fill"):   ["Actara 25 WG"],

    # ── SAFFLOWER ──────────────────────────────────────────────────────────────
    # Vertimec for spider mites + thrips which are the primary risks
    ("safflower", "pre_sowing"):   ["Cruiser 350 FS"],
    ("safflower", "early_season"): ["Vertimec 1.8 EC", "Actara 25 WG"],
    ("safflower", "tillering"):    ["Vertimec 1.8 EC"],
    ("safflower", "mid_season"):   ["Vertimec 1.8 EC"],
    ("safflower", "flowering"):    ["Vertimec 1.8 EC", "Actara 25 WG"],
    ("safflower", "late_season"):  ["Vertimec 1.8 EC"],
    ("safflower", "grain_fill"):   ["Actara 25 WG"],
}


def normalize_stage(timing_label: str | None) -> str:
    """Map any timing_label to a canonical stage category key used in STAGE_PRODUCT_MATRIX."""
    if not timing_label:
        return "mid_season"
    return _STAGE_NORM.get(str(timing_label).strip().lower(), "mid_season")


def get_stage_preferred_products(crop: str, timing_label: str | None) -> list[str]:
    """Return ordered list of preferred SKUs for this crop × growth stage.
    First item is most agronomically correct for the current stage.
    Falls back to mid_season, then crop_fit scan of the catalog.
    """
    crop_key = crop.strip().lower()
    stage = normalize_stage(timing_label)

    preferred = STAGE_PRODUCT_MATRIX.get((crop_key, stage))
    if preferred:
        return list(preferred)

    # Stage not in matrix for this crop — try mid_season fallback
    fallback = STAGE_PRODUCT_MATRIX.get((crop_key, "mid_season"))
    if fallback:
        return list(fallback)

    # Crop has no stage matrix at all — return any catalog items that fit
    return [
        sku for sku, ctx in PRODUCT_CATALOG.items()
        if crop_key in [c.strip().lower() for c in ctx.get("crop_fit", [])]
    ]


def get_product_context(sku_name: str) -> dict:
    return PRODUCT_CATALOG.get(sku_name, {
        "type": "crop protection",
        "target": "pests and diseases",
        "crop_fit": [],
        "application": "consult your local agronomist for guidance",
    })


def get_campaign_product(crop: str) -> str | None:
    """Legacy lookup — use get_stage_preferred_products() for new code."""
    return CAMPAIGN_PRODUCT_MAP.get(crop.lower())
