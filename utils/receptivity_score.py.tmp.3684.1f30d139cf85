import pandas as pd

STATE_BASELINE = {
    "Madhya Pradesh": 0.15,
    "Rajasthan":      0.14,
    "Bihar":          0.13,
    "West Bengal":    0.12,
    "Gujarat":        0.10,
    "Punjab":         0.10,
    "Uttar Pradesh":  0.09,
    "Maharashtra":    0.09,
    "Karnataka":      0.08,
    "Haryana":        0.07,
}
STATE_DEFAULT = 0.09

FARM_SIZE_TIER = {
    "1-2ac": 0.10,
    "2-5ac": 0.08,
    "<1ac":  0.07,
    "5+ac":  0.06,
}

TIMING_MAX = 0.25


def _farm_tier(size) -> str:
    try:
        s = float(size)
    except (TypeError, ValueError):
        return "<1ac"
    if s < 1:
        return "<1ac"
    if s < 2:
        return "1-2ac"
    if s < 5:
        return "2-5ac"
    return "5+ac"


def score_grower(row: pd.Series) -> dict:
    breakdown = {}

    # timing urgency (0 to TIMING_MAX)
    val = row.get("timing_urgency")
    raw_urgency = float(0.25 if val is None else val)
    breakdown["timing_urgency"] = round(raw_urgency * TIMING_MAX, 4)

    # state baseline
    state = str(row.get("state", ""))
    breakdown["state_baseline"] = STATE_BASELINE.get(state, STATE_DEFAULT)

    # farm size tier
    tier = _farm_tier(row.get("grower_farm_size"))
    breakdown["farm_size_tier"] = FARM_SIZE_TIER.get(tier, 0.07)

    # cross-channel fatigue penalty
    offline = bool(row.get("offline_campaign_attended", False))
    scan = bool(row.get("product_scan", False))
    breakdown["fatigue_penalty"] = -0.08 if (offline and scan) else 0.0

    # product scan hot-lead signal
    breakdown["scan_signal"] = 0.06 if (scan and not offline) else 0.0

    # WA engagement history
    breakdown["engagement_history"] = 0.05 if bool(row.get("wa_opened", False)) else 0.0

    # gender signal
    breakdown["gender_signal"] = 0.02 if str(row.get("gender", "")).lower() == "female" else 0.0

    raw_score = sum(breakdown.values())
    score = round(max(0.0, min(1.0, raw_score)), 4)

    # confidence based on data completeness
    missing_flags = 0
    if row.get("timing_quality_flag") in ("missing_calendar", "unknown"):
        missing_flags += 1
    if not row.get("has_wa_history", False):
        missing_flags += 1
    if pd.isna(row.get("grower_farm_size")):
        missing_flags += 1

    if missing_flags == 0:
        confidence = "high"
    elif missing_flags == 1:
        confidence = "medium"
    else:
        confidence = "low"

    return {
        "score": score,
        "breakdown": breakdown,
        "score_confidence": confidence,
        "farm_tier": tier,
    }


def score_dataframe(df: pd.DataFrame) -> pd.DataFrame:
    results = df.apply(score_grower, axis=1, result_type="expand")
    df = df.copy()
    df["receptivity_score"] = results["score"]
    df["score_confidence"] = results["score_confidence"]
    df["score_breakdown"] = results.apply(
        lambda r: r.to_dict() if hasattr(r, "to_dict") else r, axis=1
    )
    df["farm_tier"] = results["farm_tier"]
    return df
