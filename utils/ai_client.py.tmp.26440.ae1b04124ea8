import base64
import os
import re
import warnings
from openai import OpenAI
from dotenv import load_dotenv

load_dotenv()

_client: OpenAI | None = None

TEXT_MODEL_HEAVY = "anthropic/claude-sonnet-4.6"
TEXT_MODEL_FAST  = "anthropic/claude-haiku-4.5"
IMAGE_MODEL      = "openai/gpt-5-image"


def get_client() -> OpenAI:
    global _client
    if _client is None:
        key = os.getenv("TOKEN_ROUTER_KEY")
        base_url = os.getenv("TOKEN_ROUTER_BASE_URL")
        if not key or not base_url:
            raise RuntimeError(
                "TOKEN_ROUTER_KEY and TOKEN_ROUTER_BASE_URL must be set in .env"
            )
        _client = OpenAI(api_key=key, base_url=base_url)
    return _client


def call_text(
    model: str,
    system: str,
    user: str,
    temperature: float = 0.7,
) -> str:
    client = get_client()
    response = client.chat.completions.create(
        model=model,
        messages=[
            {"role": "system", "content": system},
            {"role": "user",   "content": user},
        ],
        temperature=temperature,
    )
    return response.choices[0].message.content.strip()


def call_image(model: str, prompt: str) -> str | None:
    """Generate an image via chat-completions (gpt-5-image) or the images API.
    Returns a data-URI (base64) or URL, or None on failure.

    gpt-5-image and similar models on the token router use /v1/chat/completions.
    The response content may contain an image_url block or an inline data URI.
    Falls back to the /v1/images/generate endpoint for other models.
    """
    client = get_client()

    # --- Strategy 1: chat-completions (required for gpt-5-image) ---
    try:
        response = client.chat.completions.create(
            model=model,
            messages=[{"role": "user", "content": prompt}],
            max_tokens=4096,
        )
        msg = response.choices[0].message
        content = msg.content or ""

        # Content may be a list of blocks (vision-style) or a plain string
        if isinstance(content, list):
            for block in content:
                if isinstance(block, dict):
                    if block.get("type") == "image_url":
                        url = (block.get("image_url") or {}).get("url", "")
                        if url:
                            return url
                    # Some routers embed raw base64 in a "data" field
                    if block.get("type") == "image" and block.get("data"):
                        return f"data:image/png;base64,{block['data']}"
        elif isinstance(content, str) and content.strip():
            # Plain string response — might be a URL or a data URI
            stripped = content.strip()
            if stripped.startswith("data:image/"):
                return stripped
            # Extract first URL-like token
            urls = re.findall(r"https?://\S+", stripped)
            if urls:
                return urls[0]
        return None
    except Exception as exc:
        warnings.warn(f"[ai_client] chat-completions image attempt failed: {exc}")

    # --- Strategy 2: /v1/images/generate (older models / gemini) ---
    for kwargs in [{"response_format": "b64_json"}, {}]:
        try:
            resp = client.images.generate(model=model, prompt=prompt, n=1, **kwargs)
            item = resp.data[0]
            if getattr(item, "b64_json", None):
                return f"data:image/png;base64,{item.b64_json}"
            if getattr(item, "url", None):
                return item.url
        except Exception as exc2:
            warnings.warn(f"[ai_client] images.generate attempt failed ({kwargs}): {exc2}")
    return None


def call_vision(model: str, system: str, user: str, image_b64: str,
                media_type: str = "image/jpeg") -> str:
    """Send an image + text prompt to a vision-capable model and return the text reply."""
    client = get_client()
    response = client.chat.completions.create(
        model=model,
        messages=[
            {"role": "system", "content": system},
            {
                "role": "user",
                "content": [
                    {"type": "image_url",
                     "image_url": {"url": f"data:{media_type};base64,{image_b64}"}},
                    {"type": "text", "text": user},
                ],
            },
        ],
        temperature=0.3,
        max_tokens=200,
    )
    return response.choices[0].message.content.strip()
