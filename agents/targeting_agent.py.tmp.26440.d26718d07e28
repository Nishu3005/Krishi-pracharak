import json
import os
from datetime import date, datetime

import pandas as pd

from utils.features import build_grower_features
from utils.receptivity_score import score_dataframe
from utils.data_loader import load_pos
from utils.targeting_logic import get_pos_ranked_skus, select_campaign_product
from utils.product_catalog import PRODUCT_CATALOG
from utils.ai_client import call_text, TEXT_MODEL_HEAVY
from utils.weather_client import fetch_weather_multi, fetch_weather_multi_for_districts
from utils.disease_risk import assess_risks_for_plan, assess_risk

DATA_DIR = "data"
OUTPUT_PATH = os.path.join(DATA_DIR, "targeting_plan.json")
SCORE_THRESHOLD = 0.30
MIN_SEGMENT_SIZE = 20

LANGUAGE_MAP = {
    "Uttar Pradesh": "Hindi",
    "Rajasthan":     "Hindi",
    "Madhya Pradesh":"Hindi",
    "Bihar":         "Hindi",
    "Haryana":       "Hindi",
    "Punjab":        "Punjabi",
    "Maharashtra":   "Marathi",
    "Gujarat":       "Gujarati",
    "Karnataka":     "Kannada",
    "West Bengal":   "Bengali",
}


def run_targeting(
    reference_date: date,
    crop_filter: str | list[str] | None = None,
    state_filter: str | list[str] | None = None,
    campaign_name: str | None = None,
    campaign_objective: str | None = None,
    date_window: dict | None = None,
    channel_mix: list[str] | None = None,
) -> dict:
    os.makedirs(DATA_DIR, exist_ok=True)

    df = build_grower_features(reference_date)
    df = score_dataframe(df)

    if crop_filter:
        if isinstance(crop_filter, list):
            df = df[df["crop"].str.lower().isin([c.lower() for c in crop_filter])]
        else:
            df = df[df["crop"].str.lower() == crop_filter.lower()]
    if state_filter:
        if isinstance(state_filter, list):
            df = df[df["state"].isin(state_filter)]
        else:
            df = df[df["state"] == state_filter]

    total_scored = len(df)

    # ── Fetch weather for all active states and assess disease/pest risk ──────
    active_states = df["state"].dropna().unique().tolist()
    weather_by_state = fetch_weather_multi(active_states)

    def _weather_boost(row):
        from utils.disease_risk import assess_risk
        w = weather_by_state.get(row.get("state", ""))
        risk = assess_risk(w, str(row.get("crop", "")), str(row.get("state", "")))
        return risk.get("score_boost", 0.0)

    df = df.copy()
    df["weather_boost"] = df.apply(_weather_boost, axis=1)
    df["receptivity_score"] = (df["receptivity_score"] + df["weather_boost"]).clip(0.0, 1.0)

    # ── Before threshold filter: apply disease-aware product override per grower ──
    # If weather indicates fungal or pest risk for this grower's crop+state, and
    # their current product isn't the right type, replace it now (while we still
    # have per-grower territory_id for in-stock checking).
    pos_ranked_skus = get_pos_ranked_skus(load_pos())
    df = _apply_disease_product_override(df, weather_by_state, pos_ranked_skus)

    eligible = df[df["receptivity_score"] >= SCORE_THRESHOLD].copy()

    # channel routing
    eligible["channel"] = eligible["device_type"].apply(
        lambda d: "whatsapp" if str(d).lower() == "smartphone" else "rep_assist"
    )

    # persona assignment
    eligible["persona"] = eligible.apply(_assign_persona, axis=1)

    # Safety fill: any grower still without a product (shouldn't happen after features.py,
    # but guard against edge cases)
    if "campaign_product" not in eligible.columns:
        eligible["campaign_product"] = None
    missing_product = eligible["campaign_product"].isna() | (
        eligible["campaign_product"].astype(str).str.strip() == ""
    )
    if missing_product.any():
        def _fill_missing(row):
            return select_campaign_product(
                row.get("crop"),
                pos_ranked_skus,
                timing_label=row.get("timing_label"),
                scanned_product=(
                    str(row.get("product_name")) if row.get("product_scan") else None
                ),
            )[0]
        eligible.loc[missing_product, "campaign_product"] = (
            eligible[missing_product].apply(_fill_missing, axis=1)
        )

    # OOS gate
    eligible["inventory_ok"] = ~eligible["oos_risk_product"].fillna(False)

    # ── Build segments grouped by crop × state × channel × persona × product ──
    # Products now differ per grower (stage + scan intent), so we include
    # campaign_product in the groupby to keep product-specific audiences separate.
    eligible["campaign_product"] = eligible["campaign_product"].fillna("unknown")
    segments_raw, oos_blocked = _build_segments(eligible)
    segments = _merge_small_segments(segments_raw)

    # ── Attach disease/weather context to each segment ─────────────────────────
    disease_risks = assess_risks_for_plan(weather_by_state, segments)
    for seg in segments:
        key  = f"{seg['state']}||{seg['crop']}"
        risk = disease_risks.get(key, {})
        seg["disease_risk_level"]    = risk.get("risk_level", "none")
        seg["disease_risk_type"]     = risk.get("risk_type")
        seg["disease_alert_title"]   = risk.get("alert_title")
        seg["disease_alert_body"]    = risk.get("alert_body")
        seg["spray_window_ok"]       = risk.get("spray_window_ok", True)
        seg["weather_boost_applied"] = risk.get("score_boost", 0.0)
        # Enrich disease content context with the actual product already assigned
        # to this segment so the AI content agent references the right SKU.
        raw_ctx = risk.get("content_context", "")
        product = seg.get("product", "")
        if raw_ctx and product:
            prod_info = PRODUCT_CATALOG.get(product, {})
            seg["disease_content_ctx"] = (
                raw_ctx.replace("fungicide", product).replace("insecticide", product)
                + f" The recommended product for this segment is {product}"
                f" ({prod_info.get('type','')}) — {prod_info.get('target','')}."
            )
        else:
            seg["disease_content_ctx"] = raw_ctx

    rationale = _get_rationale(segments, oos_blocked, reference_date, total_scored)

    # ── Agentic segmentation reviewer ─────────────────────────────────────────
    # Claude tool-use agent inspects weather, disease risk, and segment data,
    # then produces a priority order and tactical notes for each segment.
    agent_result = run_segmentation_agent(
        segments, weather_by_state, disease_risks, reference_date
    )
    # Merge agent priority ordering back into segments list
    priority_map = {sid: i for i, sid in enumerate(agent_result.get("priority_order", []))}
    if priority_map:
        segments.sort(key=lambda s: priority_map.get(s["segment_id"], 999))
    # Attach per-segment agent notes
    seg_notes = agent_result.get("segment_notes", {})
    for seg in segments:
        seg["agent_note"] = seg_notes.get(seg["segment_id"], "")

    plan = {
        "generated_at": datetime.utcnow().isoformat(),
        "reference_date": reference_date.isoformat(),
        "campaign_name": campaign_name,
        "campaign_objective": campaign_objective,
        "date_window": date_window,
        "channel_mix": channel_mix,
        "rationale": rationale,
        "total_growers_scored": total_scored,
        "total_eligible_pre_oos": len(eligible),
        "total_eligible": int(eligible["inventory_ok"].sum()),
        "segments": segments,
        "oos_blocked": oos_blocked,
        "quality_summary": _quality_summary(df, eligible),
        "disease_risks": {k: {
            "risk_level":    v.get("risk_level"),
            "risk_type":     v.get("risk_type"),
            "alert_title":   v.get("alert_title"),
            "alert_body":    v.get("alert_body"),
            "spray_window_ok": v.get("spray_window_ok", True),
        } for k, v in disease_risks.items()},
        "weather_by_state": {
            s: {"condition": w.get("condition"), "temp_c": w.get("temp_c"),
                "humidity_pct": w.get("humidity_pct"), "wind_kmh": w.get("wind_kmh"),
                "rain_3day": sum(d.get("rain_mm") or 0 for d in (w.get("forecast_3day") or [])),
                "is_fallback": w.get("_is_fallback", False)}
            for s, w in weather_by_state.items() if w
        },
        "agent_insight": {
            "campaign_advice": agent_result.get("campaign_advice", ""),
            "tool_calls_made": agent_result.get("tool_calls_made", []),
            "segments_prioritised": len(agent_result.get("priority_order", [])),
        },
    }

    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(plan, f, indent=2, ensure_ascii=False)

    return plan


def _apply_disease_product_override(
    df: pd.DataFrame,
    weather_by_state: dict,
    pos_ranked_skus: list[str],
) -> pd.DataFrame:
    """
    For growers whose crop+state has an active disease/pest outbreak, reassign
    the campaign product to the correct type (fungicide / insecticide) if their
    current product is the wrong type.  Runs per grower so inventory checks
    still use territory_id.
    """
    from utils.disease_risk import assess_risk

    # Build a lightweight (state, crop) → risk_type cache to avoid O(n) weather calls
    risk_cache: dict[tuple[str, str], str | None] = {}
    for state in df["state"].dropna().unique():
        w = weather_by_state.get(state)
        for crop in df[df["state"] == state]["crop"].dropna().unique():
            risk = assess_risk(w, str(crop), str(state))
            risk_cache[(str(state), str(crop))] = risk.get("risk_type")

    df = df.copy()

    def _override(row):
        state = str(row.get("state") or "")
        crop  = str(row.get("crop")  or "")
        risk_type = risk_cache.get((state, crop))
        if risk_type not in ("fungal", "pest"):
            return row.get("campaign_product")

        product_type_wanted = "fungicide" if risk_type == "fungal" else "insecticide"
        current = str(row.get("campaign_product") or "")
        current_type = PRODUCT_CATALOG.get(current, {}).get("type", "")
        if current_type.startswith(product_type_wanted):
            return current  # already correct

        crop_key = crop.lower()
        candidates = [
            sku for sku, ctx in PRODUCT_CATALOG.items()
            if ctx.get("type", "").startswith(product_type_wanted)
            and crop_key in [c.strip().lower() for c in ctx.get("crop_fit", [])]
        ]
        if not candidates:
            return current  # no suitable product — keep original

        for sku in pos_ranked_skus:
            if sku in candidates:
                return sku
        return candidates[0]

    df["campaign_product"] = df.apply(_override, axis=1)
    return df


def _assign_persona(row: pd.Series) -> str:
    scan    = bool(row.get("product_scan", False))
    offline = bool(row.get("offline_campaign_attended", False))
    days    = row.get("days_to_next_stage")

    if scan and not offline:
        return "hot_lead"
    try:
        d = int(days)
        if 0 <= d <= 14:
            return "pre_stage_alert"
    except (TypeError, ValueError):
        pass
    if offline and not scan:
        return "offline_reinforcement"
    return "awareness"


def _build_segments(df: pd.DataFrame) -> tuple[list, list]:
    segments    = []
    oos_blocked = []
    seg_id      = 1

    # Group by product as well — growers with different products (different stages or scan intent)
    # belong to different segments with different content.
    group_keys = ["crop", "state", "channel", "persona", "campaign_product"]
    for keys, group in df.groupby(group_keys):
        crop, state, channel, persona, product = keys
        language = LANGUAGE_MAP.get(state, "Hindi")

        eligible_group = group[group["inventory_ok"]]
        blocked_group  = group[~group["inventory_ok"]]

        if not eligible_group.empty:
            days_vals = eligible_group["days_to_next_stage"].dropna()
            if not days_vals.empty:
                days_int    = int(days_vals.median())
                stage_label = eligible_group["timing_label"].iloc[0]
                stage_context = (
                    f"{stage_label} in {days_int} days"
                    if days_int >= 0
                    else f"{stage_label} ({abs(days_int)} days ago)"
                )
            else:
                stage_context = (
                    eligible_group["timing_label"].iloc[0] if len(eligible_group) else "unknown"
                )

            # Capture the dominant product selection reason for transparency
            reason_col = eligible_group.get("product_selection_reason") if hasattr(eligible_group, "get") else None
            if reason_col is not None and "product_selection_reason" in eligible_group.columns:
                selection_reason = eligible_group["product_selection_reason"].mode().iloc[0] if len(eligible_group) else ""
            else:
                selection_reason = ""

            segments.append({
                "segment_id":            f"SEG_{seg_id:03d}",
                "crop":                  crop,
                "state":                 state,
                "language":              language,
                "channel":               channel,
                "persona":               persona,
                "product":               product,
                "product_selection_reason": selection_reason,
                "stage_context":         stage_context,
                "grower_count":          len(eligible_group),
                "avg_score":             round(eligible_group["receptivity_score"].mean(), 3),
                "inventory_ok":          True,
                "grower_ids":            eligible_group["grower_id"].tolist(),
            })
            seg_id += 1

        if not blocked_group.empty:
            oos_blocked.append({
                "crop":         crop,
                "state":        state,
                "product":      product,
                "grower_count": len(blocked_group),
                "reason":       "OOS risk — inventory_blocked=True in territory",
            })

    return segments, oos_blocked


def _merge_small_segments(segments: list) -> list:
    small = [s for s in segments if s["grower_count"] < MIN_SEGMENT_SIZE]
    large = [s for s in segments if s["grower_count"] >= MIN_SEGMENT_SIZE]

    for s in small:
        best = _find_merge_target(s, large)
        if best:
            best["grower_ids"].extend(s["grower_ids"])
            best["grower_count"] += s["grower_count"]
            best["avg_score"] = round(
                (best["avg_score"] * (best["grower_count"] - s["grower_count"]) +
                 s["avg_score"] * s["grower_count"]) / best["grower_count"], 3
            )
        else:
            large.append(s)

    return large


def _find_merge_target(small: dict, candidates: list) -> dict | None:
    # 1) Strict: same crop/state/channel/product/language — safest merge
    for c in candidates:
        if (
            c["crop"]     == small["crop"]
            and c["state"]    == small["state"]
            and c["channel"]  == small["channel"]
            and c["product"]  == small["product"]
            and c["language"] == small["language"]
        ):
            return c
    # 2) Relax: same crop/state/channel but different product — acceptable when
    #    the small segment is too tiny to generate meaningful content on its own
    for c in candidates:
        if (
            c["crop"]    == small["crop"]
            and c["state"]   == small["state"]
            and c["channel"] == small["channel"]
        ):
            return c
    # 3) No safe target — keep as its own segment
    return None


def _get_rationale(segments: list, oos_blocked: list, reference_date: date, total: int) -> str:
    seg_summary = "\n".join(
        f"- {s['crop'].title()} / {s['state']} / {s['channel']} / {s['persona']}: "
        f"{s['grower_count']} growers, avg score {s['avg_score']}, "
        f"product: {s['product']} ({s.get('product_selection_reason','')})"
        for s in segments[:15]
    )
    blocked_summary = "\n".join(
        f"- {b['crop'].title()} in {b['state']}: {b['product']} blocked ({b['grower_count']} growers)"
        for b in oos_blocked[:5]
    )

    prompt = f"""You are a Syngenta campaign planning analyst.
Reference date: {reference_date}. Total growers scored: {total}.

Targeting segments selected:
{seg_summary}

OOS-blocked (campaigns not running due to stock risk):
{blocked_summary if blocked_summary else "None"}

Write a concise 3-4 sentence campaign rationale explaining:
1. Why these segments were prioritised (timing, engagement signals, growth stage)
2. What product was chosen for each segment and why (stage-aware or scan-intent driven)
3. What the inventory gate prevented
4. What the expected outcome is for field teams and conversion rates
Be direct, factual, written for a Syngenta marketing manager."""

    try:
        return call_text(
            model=TEXT_MODEL_HEAVY,
            system="You are a precise agricultural marketing analyst at Syngenta India.",
            user=prompt,
            temperature=0.5,
        )
    except Exception:
        top_seg = segments[0] if segments else {}
        blocked = sum(int(b.get("grower_count", 0)) for b in oos_blocked)
        if segments:
            return (
                f"Reference date {reference_date}: {total} growers were scored and {len(segments)} "
                f"campaign segment(s) activated. Top segment: {top_seg.get('crop','').title()} "
                f"in {top_seg.get('state','-')}, channel {top_seg.get('channel','-')}, "
                f"product {top_seg.get('product','-')} ({top_seg.get('product_selection_reason','')}) "
                f"— {top_seg.get('grower_count',0)} growers at avg score {top_seg.get('avg_score',0)}. "
                f"Inventory gate blocked {blocked} growers across {len(oos_blocked)} segment(s)."
            )
        return (
            f"Reference date {reference_date}: {total} growers scored but no eligible segments "
            f"activated after threshold and inventory checks."
        )


def run_segmentation_agent(
    segments: list[dict],
    weather_by_state: dict,
    disease_risks: dict,
    reference_date: date,
) -> dict:
    """
    Claude tool-use agent that reviews the pre-built segments and produces:
      - priority_order : list of segment_ids, most urgent first
      - segment_notes  : {segment_id: str} — per-segment tactical note
      - campaign_advice: overall campaign strategy note
      - tool_calls_made: list of tool call log for transparency

    The agent has access to 4 tools and decides which ones to call.
    Falls back to an empty dict on any error so it never blocks the pipeline.
    """
    try:
        from utils.ai_client import get_client, TEXT_MODEL_HEAVY
        from utils.disease_risk import assess_risk

        # ── Tool definitions ──────────────────────────────────────────────────
        tools = [
            {
                "type": "function",
                "function": {
                    "name": "check_weather",
                    "description": (
                        "Get current weather conditions (temperature, humidity, rainfall, wind) "
                        "for an Indian state. Use this to understand disease/spray risk."
                    ),
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "state": {"type": "string", "description": "Indian state name, e.g. 'Rajasthan'"},
                        },
                        "required": ["state"],
                    },
                },
            },
            {
                "type": "function",
                "function": {
                    "name": "check_disease_risk",
                    "description": (
                        "Assess disease and pest outbreak risk for a specific crop in a state "
                        "based on current weather. Returns risk level, type, and score boost."
                    ),
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "state": {"type": "string"},
                            "crop":  {"type": "string", "description": "Crop name, e.g. 'wheat'"},
                        },
                        "required": ["state", "crop"],
                    },
                },
            },
            {
                "type": "function",
                "function": {
                    "name": "get_segment_details",
                    "description": "Get full details of a specific segment by its segment_id.",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "segment_id": {"type": "string", "description": "e.g. 'SEG_001'"},
                        },
                        "required": ["segment_id"],
                    },
                },
            },
            {
                "type": "function",
                "function": {
                    "name": "get_top_segments_by_score",
                    "description": (
                        "Return the top N segments ranked by average receptivity score × grower count. "
                        "Use this to understand which segments are highest priority."
                    ),
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "top_n": {
                                "type": "integer",
                                "description": "How many top segments to return (default 5)",
                            },
                        },
                        "required": [],
                    },
                },
            },
        ]

        # ── Tool implementations ──────────────────────────────────────────────
        seg_index = {s["segment_id"]: s for s in segments}

        def _execute_tool(name: str, args: dict) -> str:
            if name == "check_weather":
                w = weather_by_state.get(args["state"])
                if not w:
                    return json.dumps({"error": f"No weather data for {args['state']}"})
                return json.dumps({
                    "state":       args["state"],
                    "temp_c":      w.get("temp_c"),
                    "humidity":    w.get("humidity_pct"),
                    "wind_kmh":    w.get("wind_kmh"),
                    "condition":   w.get("condition"),
                    "is_fallback": w.get("_is_fallback", False),
                    "rain_3day_mm": sum(d.get("rain_mm", 0) for d in (w.get("forecast_3day") or [])),
                })

            if name == "check_disease_risk":
                w = weather_by_state.get(args["state"])
                risk = assess_risk(w, args["crop"], args["state"])
                return json.dumps({
                    "state":       args["state"],
                    "crop":        args["crop"],
                    "risk_level":  risk["risk_level"],
                    "risk_type":   risk["risk_type"],
                    "alert_title": risk["alert_title"],
                    "score_boost": risk["score_boost"],
                    "spray_ok":    risk["spray_window_ok"],
                })

            if name == "get_segment_details":
                seg = seg_index.get(args["segment_id"])
                if not seg:
                    return json.dumps({"error": "segment not found"})
                return json.dumps({
                    k: v for k, v in seg.items()
                    if k != "grower_ids"  # omit large list
                })

            if name == "get_top_segments_by_score":
                n = int(args.get("top_n", 5))
                ranked = sorted(
                    segments,
                    key=lambda s: s["avg_score"] * s["grower_count"],
                    reverse=True,
                )[:n]
                return json.dumps([
                    {
                        "segment_id":   s["segment_id"],
                        "crop":         s["crop"],
                        "state":        s["state"],
                        "persona":      s["persona"],
                        "product":      s["product"],
                        "grower_count": s["grower_count"],
                        "avg_score":    s["avg_score"],
                        "stage":        s.get("stage_context", ""),
                    }
                    for s in ranked
                ])

            return json.dumps({"error": f"Unknown tool: {name}"})

        # ── Build initial prompt ──────────────────────────────────────────────
        seg_overview = "\n".join(
            f"  {s['segment_id']}: {s['crop'].title()} / {s['state']} / "
            f"{s['persona']} / {s['channel']} — "
            f"{s['grower_count']} growers, score {s['avg_score']}, "
            f"product {s['product']}, stage: {s.get('stage_context','?')}"
            for s in segments[:20]
        )
        total_growers = sum(s["grower_count"] for s in segments)
        states_list   = sorted({s["state"] for s in segments})

        system_prompt = (
            "You are a Syngenta India campaign strategist and expert agronomist. "
            "You have access to real-time weather, disease risk, and segment data via tools. "
            "Use the tools to investigate the most important segments and weather conditions, "
            "then return a JSON object with EXACTLY these keys:\n"
            '  "priority_order": [list of segment_ids, highest priority first],\n'
            '  "segment_notes": {"SEG_XXX": "one-line tactical note", ...},\n'
            '  "campaign_advice": "2-3 sentence overall strategy"\n'
            "Investigate at least 3 segments and check weather for at least 2 states. "
            "Return ONLY the JSON object, no markdown wrapper."
        )
        user_prompt = (
            f"Reference date: {reference_date}. "
            f"Campaign covers {len(segments)} segments, {total_growers:,} growers "
            f"across {', '.join(states_list)}.\n\n"
            f"Segments overview:\n{seg_overview}\n\n"
            "Use the tools to investigate key segments and weather conditions, "
            "then return your prioritised campaign strategy as JSON."
        )

        client = get_client()
        messages = [
            {"role": "system", "content": system_prompt},
            {"role": "user",   "content": user_prompt},
        ]
        tool_call_log = []

        # ── Agentic loop: up to 8 tool calls ─────────────────────────────────
        for _iteration in range(8):
            response = client.chat.completions.create(
                model=TEXT_MODEL_HEAVY,
                messages=messages,
                tools=tools,
                tool_choice="auto",
                temperature=0.3,
            )
            msg = response.choices[0].message

            # No more tool calls → agent is done
            if not msg.tool_calls:
                raw = (msg.content or "").strip()
                # Strip markdown fences if present
                raw = raw.lstrip("```json").lstrip("```").rstrip("```").strip()
                result = json.loads(raw)
                result["tool_calls_made"] = tool_call_log
                return result

            # Execute each tool call and feed results back
            messages.append({"role": "assistant", "content": msg.content,
                              "tool_calls": [tc.model_dump() for tc in msg.tool_calls]})
            for tc in msg.tool_calls:
                args    = json.loads(tc.function.arguments)
                outcome = _execute_tool(tc.function.name, args)
                tool_call_log.append({"tool": tc.function.name, "args": args})
                messages.append({
                    "role":         "tool",
                    "tool_call_id": tc.id,
                    "content":      outcome,
                })

        return {"campaign_advice": "Agent iteration limit reached.", "tool_calls_made": tool_call_log}

    except Exception as exc:
        return {"campaign_advice": f"Segmentation agent unavailable: {exc}", "tool_calls_made": []}


def _quality_summary(full_df: pd.DataFrame, eligible: pd.DataFrame) -> dict:
    total = len(full_df)
    return {
        "total_growers":       total,
        "missing_calendar":    int((full_df["timing_quality_flag"] == "missing_calendar").sum()),
        "stage_based":         int((full_df["timing_mode"] == "stage_based").sum()),
        "season_phase":        int((full_df["timing_mode"] == "season_phase").sum()),
        "below_threshold":     int(total - len(eligible)),
        "oos_blocked_growers": int(eligible["oos_risk_product"].sum()),
        "non_smartphone":      int((full_df["device_type"] != "smartphone").sum()),
    }
