from utils.ai_client import call_text, call_image, call_vision, TEXT_MODEL_FAST, TEXT_MODEL_HEAVY, IMAGE_MODEL
from utils.product_catalog import get_product_context

DATA_DIR = "data"
OUTPUT_PATH = os.path.join(DATA_DIR, "content_variants.json")

PERSONA_TONE = {
    "hot_lead": (
        "The farmer already scanned this product. Use a direct conversion CTA — "
        "they know the product, push them to buy now from their local retailer."
    ),
    "pre_stage_alert": (
        "Urgent. A critical crop stage is approaching. Emphasise that acting now "
        "will protect their crop. Time-sensitive tone."
    ),
    "offline_reinforcement": (
        "The farmer attended a Syngenta field event. Reinforce what they learned. "
        "Warm, familiar tone — like a follow-up from someone they met."
    ),
    "awareness": (
        "Educational and trustworthy. Introduce the product benefit clearly. "
        "Simple language. Do not assume prior product knowledge."
    ),
}

_FALLBACK_RETAILER = {
    "Hindi":   "अपने नजदीकी Syngenta डीलर से संपर्क करें।",
    "Punjabi": "ਆਪਣੇ ਨਜ਼ਦੀਕੀ Syngenta ਡੀਲਰ ਨਾਲ ਸੰਪਰਕ ਕਰੋ।",
    "Marathi": "जवळच्या Syngenta विक्रेत्याशी संपर्क साधा।",
    "Gujarati": "તમારા નજીકના Syngenta ડીલરનો સંપર્ક કરો।",
    "Kannada": "ನಿಮ್ಮ ಹತ್ತಿರದ Syngenta ಡೀಲರ್ ಅನ್ನು ಸಂಪರ್ಕಿಸಿ।",
    "Bengali": "আপনার নিকটস্থ Syngenta ডিলারের সাথে যোগাযোগ করুন।",
}
_FALLBACK_RETAILER_EN = "Contact your nearest Syngenta retailer."

LANGUAGE_NOTES = {
    "Hindi":   "Write in simple, conversational Hindi. Use Devanagari script. Avoid complex vocabulary.",
    "Punjabi": "Write in Punjabi using Gurmukhi script. Warm, direct tone.",
    "Marathi": "Write in Marathi using Devanagari script. Respectful, farmer-friendly tone.",
    "Gujarati": "Write in Gujarati script. Clear and practical.",
    "Kannada": "Write in Kannada script. Simple and respectful.",
    "Bengali": "Write in Bengali script. Friendly and clear.",
}

_RETRY_DELAY_S = 0.6


def describe_promoter(image_b64: str) -> str:
    """Use Claude vision to describe a promoter/brand-ambassador photo for poster prompting."""
    return call_vision(
        model=TEXT_MODEL_HEAVY,
        system="You are a visual description assistant for marketing teams.",
        user=(
            "Describe this person briefly for a poster-generation prompt. "
            "Cover: gender presentation, approximate age, clothing style, and overall demeanor. "
            "Keep it to 1-2 sentences. Be neutral and factual."
        ),
        image_b64=image_b64,
        media_type="image/jpeg",
    )


def run_content_generation(targeting_plan: dict,
                           promoter_image_b64: str | None = None) -> dict:
    os.makedirs(DATA_DIR, exist_ok=True)

    # Derive a text description of the promoter once (saves API calls per segment)
    promoter_desc: str | None = None
    if promoter_image_b64:
        try:
            promoter_desc = describe_promoter(promoter_image_b64)
        except Exception:
            promoter_desc = None

    variants = {}
    segments = targeting_plan.get("segments", [])

    for seg in segments:
        if not seg.get("inventory_ok", True):
            continue
        seg_id = seg["segment_id"]
        variants[seg_id] = _generate_segment_content(seg, promoter_desc)

    output = {
        "generated_at": datetime.utcnow().isoformat(),
        "total_segments": len(variants),
        "variants": variants,
    }

    with open(OUTPUT_PATH, "w", encoding="utf-8") as f:
        json.dump(output, f, indent=2, ensure_ascii=False)

    return output


def _call_with_retry(fn, *args, **kwargs) -> tuple[Optional[str], str]:
    """Call fn once; on failure wait _RETRY_DELAY_S and retry once.
    Returns (result, status) where status is 'success' or 'fallback'.
    """
    for attempt in range(2):
        try:
            result = fn(*args, **kwargs)
            return result, "success"
        except Exception:
            if attempt == 0:
                time.sleep(_RETRY_DELAY_S)
    return None, "fallback"


def _text_meta(text: Optional[str], status: str) -> dict:
    return {
        "status": status,
        "char_count": len(text) if text else 0,
        "generated_at": datetime.utcnow().isoformat(),
        "model": TEXT_MODEL_FAST,
    }


def _generate_segment_content(seg: dict, promoter_desc: str | None = None) -> dict:
    language  = seg.get("language", "Hindi")
    persona   = seg.get("persona", "awareness")
    product   = seg.get("product", "")
    crop      = seg.get("crop", "")
    state     = seg.get("state", "")
    channel   = seg.get("channel", "whatsapp")
    stage_ctx = seg.get("stage_context", "")

    product_info = get_product_context(product)
    tone_note    = PERSONA_TONE.get(persona, PERSONA_TONE["awareness"])
    lang_note    = LANGUAGE_NOTES.get(language, LANGUAGE_NOTES["Hindi"])

    context_block = (
        f"Crop: {crop}. Region: {state}, India. Growth stage context: {stage_ctx}. "
        f"Product: {product} ({product_info.get('type', '')}) — "
        f"targets {product_info.get('target', '')}. "
        f"Application: {product_info.get('application', '')}."
    )

    if channel == "whatsapp":
        wa_text, wa_status = _call_with_retry(
            _gen_whatsapp, context_block, tone_note, lang_note, language
        )
        _retailer_line = _FALLBACK_RETAILER.get(language, _FALLBACK_RETAILER_EN)
        if wa_status == "fallback":
            wa_text = _retailer_line
        sms_text, sms_status = _call_with_retry(
            _gen_sms, context_block, tone_note, lang_note, language
        )
        if sms_status == "fallback":
            sms_text = _retailer_line
        ivr_text, ivr_status = _call_with_retry(
            _gen_ivr, context_block, tone_note, lang_note, language
        )
        if ivr_status == "fallback":
            ivr_text = _retailer_line
    else:
        # rep_assist channel — WhatsApp/SMS not sent; produce field visit script only
        wa_text, sms_text = None, None
        wa_status, sms_status = "skipped", "skipped"
        ivr_text, ivr_status = _call_with_retry(
            _gen_rep_assist_script, context_block, tone_note, lang_note, language
        )
        _retailer_line = _FALLBACK_RETAILER.get(language, _FALLBACK_RETAILER_EN)
        if ivr_status == "fallback":
            ivr_text = _retailer_line

    poster_prompt = _build_poster_prompt(crop, product, state, language, stage_ctx, persona, promoter_desc)
    poster_url, poster_status = _call_with_retry(call_image, IMAGE_MODEL, poster_prompt)

    return {
        "channel":          channel,
        "language":         language,
        "persona":          persona,
        "whatsapp":         wa_text,
        "whatsapp_meta":    _text_meta(wa_text, wa_status) if wa_status != "skipped" else None,
        "sms":              sms_text,
        "sms_meta":         _text_meta(sms_text, sms_status) if sms_status != "skipped" else None,
        "ivr_script":       ivr_text,
        "ivr_meta":         _text_meta(ivr_text, ivr_status),
        "poster_image_url": poster_url,
        "poster_status":    poster_status,
        "poster_prompt_used": poster_prompt,
        "poster_generated_at": datetime.utcnow().isoformat(),
        "models_used": {
            "text":  TEXT_MODEL_FAST,
            "image": IMAGE_MODEL,
        },
    }


def _gen_whatsapp(context: str, tone: str, lang_note: str, language: str) -> str:
    system = "You are a Syngenta agricultural marketing copywriter specialising in rural farmer communication."
    user = f"""{context}

Tone instruction: {tone}
Language instruction: {lang_note}

Write a WhatsApp message for this farmer segment. Requirements:
- Maximum 200 characters
- Must be in {language}
- Include the product name naturally
- End with a clear action (ask retailer / apply now / call helpline)
- No hashtags. No formal salutation. Direct and warm.

Return only the message text."""
    return call_text(TEXT_MODEL_FAST, system, user, temperature=0.75)


def _gen_sms(context: str, tone: str, lang_note: str, language: str) -> str:
    system = "You are a Syngenta agricultural marketing copywriter specialising in rural farmer communication."
    user = f"""{context}

Tone instruction: {tone}
Language instruction: {lang_note}

Write an SMS message for this farmer segment. Requirements:
- Maximum 120 characters
- Must be in {language}
- No emoji. Feature-phone compatible.
- Include the product name and one clear action

Return only the SMS text."""
    return call_text(TEXT_MODEL_FAST, system, user, temperature=0.7)


def _gen_ivr(context: str, tone: str, lang_note: str, language: str) -> str:
    system = "You are a Syngenta agricultural marketing copywriter specialising in rural farmer communication."
    user = f"""{context}

Tone instruction: {tone}
Language instruction: {lang_note}

Write a 30-second IVR (voice call) script for this farmer segment. Requirements:
- Spoken naturally, as if read aloud by a warm voice
- Must be in {language}
- Approximately 60-80 words
- Open with a greeting relevant to the farming season
- Mention the crop stage, the risk, and the product as the solution
- Close with: "Ask for [product name] at your nearest Syngenta retailer."

Return only the script text."""
    return call_text(TEXT_MODEL_FAST, system, user, temperature=0.7)


def _gen_rep_assist_script(context: str, tone: str, lang_note: str, language: str) -> str:
    system = "You are a Syngenta field communication specialist helping reps with short visit scripts."
    user = f"""{context}

Tone instruction: {tone}
Language instruction: {lang_note}

Write a short in-person rep-assist script for this segment. Requirements:
- Must be in {language}
- 45-70 words
- Spoken naturally in a field conversation
- Mention crop stage risk and product recommendation clearly
- End with one practical next step the rep should ask the grower to take today

Return only the script text."""
    return call_text(TEXT_MODEL_FAST, system, user, temperature=0.65)


def _build_poster_prompt(
    crop: str, product: str, state: str, language: str,
    stage_ctx: str, persona: str, promoter_desc: str | None = None,
) -> str:
    urgency = "urgent, time-sensitive" if persona == "pre_stage_alert" else "informative, trustworthy"
    promoter_part = (
        f"Feature this person prominently as a brand ambassador in the foreground: {promoter_desc} "
        if promoter_desc else ""
    )
    return (
        f"Agricultural campaign poster for {crop} farmers in {state}, India. "
        f"Product: {product}. Growth stage: {stage_ctx}. "
        f"Mood: {urgency}. "
        f"{promoter_part}"
        f"Include text overlay in {language} language. "
        f"Style: simple, high contrast, suitable for low-literacy rural audience. "
        f"Show the {crop} plant and product packaging. Clean layout, bold text, no complex graphics."
    )
