# ============================================================
#  Syngenta Campaign AI — Environment Variables
#  Copy this file to .env and fill in the values before running.
#  NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# TOKEN ROUTER API
# The app uses a single OpenAI-compatible endpoint that routes
# to multiple model providers (Anthropic Claude, Google Gemini,
# etc.) via the Token Router service.
# ------------------------------------------------------------

# Your Token Router API key.
# Format:  a long alphanumeric string, e.g.  sk-tr-xxxxxxxxxxxxxxxxxxxx
# Where to get it:  provided by the hackathon organiser / Token Router dashboard.
TOKEN_ROUTER_KEY=sk-tr-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the Token Router API endpoint.
# Must end WITHOUT a trailing slash.
# Example:  https://api.token-router.io/v1
# Where to get it:  same source as TOKEN_ROUTER_KEY; see spec/token-router.md for details.
TOKEN_ROUTER_BASE_URL=https://api.token-router.io/v1


# ------------------------------------------------------------
# DATA DIRECTORY
# Path (relative to the repo root) that contains all CSV datasets.
# Default matches the folder name in the hackathon data release.
# Only change this if you renamed or moved the data folder.
# ------------------------------------------------------------

# Directory that holds growers.csv, whatsapp_campaign.csv, retailers.csv,
# retailer_inventory_weekly.csv, retailer_pos.csv, retailer_visit_log.csv,
# reps_territory.csv, and digital_funnel_weekly.csv.
# Relative path from the project root, no trailing slash.
DATA_DIR=Syngenta_IITM_Hackathon_2026_dataset
